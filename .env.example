# Variables of the stack (see scripts/portainer_deploy.py). The deploy script sets what it can;
# for a local setup copy this file to .env. Never commit the real file.

# The image to run, for example oloop-server:abc1234. The deploy script takes the newest one.
OLOOP_IMAGE=

POSTGRES_PASSWORD=change-me

# Where the data lives on the host: blobs/ and pgdata/ below this folder. The compose file has a default.
# OLOOP_STORAGE=/srv/oloop

# The user the server runs as. It must be allowed to write to blobs/ (the init step of the stack
# takes care of it). Default 10001, the user of the image.
# OLOOP_UID=10001
# OLOOP_GID=10001

# Addresses or networks of the reverse proxy, comma separated. Empty trusts no proxy.
OLOOP_TRUSTED_PROXIES=
