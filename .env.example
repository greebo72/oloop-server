# Copy to .env. Never commit the real file.
POSTGRES_PASSWORD=change-me

# Where the data lives on the host: blobs/ and pgdata/ below this folder.
# Default ./storage next to the compose file. Use an absolute path when the
# stack is started from somewhere else, for example by Portainer.
# OLOOP_STORAGE=./storage

# The user the server runs as. It must be allowed to write to blobs/.
# Default 10001 (the user of the image); `id -u` / `id -g` take your own.
# OLOOP_UID=10001
# OLOOP_GID=10001

# Addresses of the reverse proxy, comma separated. Empty trusts no proxy.
OLOOP_TRUSTED_PROXIES=
